{
  "name": "bajkot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "react-router dev --open",
    "dev:backend": "convex dev",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "npm run prebuild && react-router build",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\" \"convex/**/*.ts\" \"*.{md,cjs,js,ts,json}\"",
    "lint": "tsc -p convex -noEmit --pretty false && tsc -p . -noEmit --pretty false && eslint \"src/**/*.{ts,tsx}\" && convex dev --once && react-router build",
    "deploy": "convex deploy --cmd 'npm run build' && vercel --prod",
    "deploy:backend": "convex deploy",
    "deploy:frontend": "vercel --prod",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "setup:staging": "bash scripts/setup-staging.sh",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:debug": "PWDEBUG=1 playwright test --config=e2e/playwright.config.ts",
    "test:e2e:login": "playwright test e2e/tests/00-login.spec.ts --config=e2e/playwright.config.ts --headed --global-timeout 360000",
    "e2e:login": "playwright test e2e/tests/00-login.spec.ts --config=e2e/playwright.config.ts --headed --global-timeout 360000",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.71",
    "@clerk/clerk-react": "^5.59.2",
    "@clerk/react-router": "^2.4.10",
    "@convex-dev/auth": "^0.0.91",
    "@langfuse/client": "^4.4.2",
    "@langfuse/otel": "^4.4.2",
    "@langfuse/tracing": "^4.4.2",
    "@openrouter/ai-sdk-provider": "^1.2.5",
    "@posthog/react": "^1.5.2",
    "@react-router/node": "^7.13.1",
    "@react-router/serve": "^7.13.1",
    "@vercel/react-router": "^1.2.5",
    "ai": "^5.0.117",
    "clsx": "^2.1.1",
    "convex": "^1.24.2",
    "crypto": "^1.0.1",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "isbot": "^5",
    "jspdf": "^4.2.0",
    "openai": "^6.8.1",
    "posthog-js": "^1.316.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-rnd": "^10.5.2",
    "react-router": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.57.0",
    "@react-router/dev": "^7.13.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "~10",
    "dotenv": "^17.3.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "npm-run-all": "^4.1.5",
    "postcss": "~8",
    "prettier": "^3.5.3",
    "tailwindcss": "~3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.24.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
