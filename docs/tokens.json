{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "version": "1.0",
    "updated": "2026-02-13",
    "source": "visual_brand_system.md"
  },
  "color": {
    "accent": {
      "default": { "value": "#ff6b35", "description": "Brand accent — CTAs, active states, brand emphasis" },
      "hover": { "value": "#e55a2b", "description": "Hover/pressed states on accent elements" },
      "subtle": { "value": "#fff5f0", "description": "Accent backgrounds, badges, highlight areas" },
      "dark": { "value": "#cc4a1a", "description": "Text on accent-subtle backgrounds (passes AA on white)" }
    },
    "ink": {
      "default": { "value": "#0f0f0f", "description": "Primary text, headings, dark buttons" },
      "secondary": { "value": "#525252", "description": "Body text, descriptions" }
    },
    "muted": { "value": "#737373", "description": "Captions, placeholders, timestamps" },
    "line": {
      "default": { "value": "#e5e5e5", "description": "Borders, dividers" },
      "subtle": { "value": "#f0f0f0", "description": "Subtle separators, table rows" }
    },
    "surface": {
      "default": { "value": "#ffffff", "description": "Page background" },
      "subtle": { "value": "#fafafa", "description": "Card backgrounds, sections" },
      "muted": { "value": "#f5f5f5", "description": "Muted backgrounds, code blocks" }
    },
    "semantic": {
      "success": { "value": "#16a34a", "subtle": "#f0fdf4" },
      "warning": { "value": "#ca8a04", "subtle": "#fefce8" },
      "error": { "value": "#dc2626", "subtle": "#fef2f2" }
    },
    "segment": {
      "business": {
        "accent": { "value": "#1e3a5f", "description": "Navy" },
        "subtle": { "value": "#f0f4f8" }
      },
      "education": {
        "accent": { "value": "#4a7c59", "description": "Forest green" },
        "subtle": { "value": "#f0f7f2" }
      },
      "executive": {
        "accent": { "value": "#4a5568", "description": "Slate" },
        "subtle": { "value": "#f7f8f9" }
      }
    },
    "scrollReader": {
      "bg": { "value": "#faf8f5", "description": "Warm off-white page" },
      "text": { "value": "#3b3632", "description": "Warm brown body text" },
      "heading": { "value": "#1c1816", "description": "Near-black headings" },
      "muted": { "value": "#8c8279", "description": "Secondary/caption text" },
      "accent": { "value": "#8B6914", "description": "Brass/gold highlights" },
      "accentSubtle": { "value": "#f7f3ea", "description": "Warm highlight backgrounds" },
      "completion": { "value": "#7a6e5d", "description": "Progress, bookmarks" }
    }
  },
  "typography": {
    "fontFamily": {
      "primary": { "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" },
      "openTypeFeatures": { "value": "'cv02', 'cv03', 'cv04', 'cv11'" }
    },
    "scale": {
      "display": { "size": "2.5rem", "weight": 700, "lineHeight": 1.1, "letterSpacing": "-0.025em" },
      "h1": { "size": "2rem", "weight": 700, "lineHeight": 1.2, "letterSpacing": "-0.02em" },
      "h2": { "size": "1.5rem", "weight": 600, "lineHeight": 1.25, "letterSpacing": "-0.02em" },
      "h3": { "size": "1.125rem", "weight": 600, "lineHeight": 1.3, "letterSpacing": "-0.015em" },
      "body": { "size": "1rem", "weight": 400, "lineHeight": 1.6, "letterSpacing": "0" },
      "bodySmall": { "size": "0.875rem", "weight": 400, "lineHeight": 1.5, "letterSpacing": "0" },
      "caption": { "size": "0.75rem", "weight": 500, "lineHeight": 1.4, "letterSpacing": "0.01em" },
      "overline": { "size": "0.75rem", "weight": 600, "lineHeight": 1.4, "letterSpacing": "0.08em", "textTransform": "uppercase" },
      "2xs": { "size": "0.6875rem", "weight": 500, "lineHeight": "1rem", "letterSpacing": "0.01em" },
      "button": { "size": "0.875rem", "weight": 600, "lineHeight": 1, "letterSpacing": "0" }
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "spacing": {
    "unit": "4px",
    "scale": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "section": "32px",
      "12": "48px",
      "16": "64px"
    }
  },
  "borderRadius": {
    "sm": "6px",
    "default": "8px",
    "lg": "12px",
    "xl": "16px",
    "2xl": "20px",
    "container": "12px",
    "chip": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.03)",
    "default": "0 1px 3px 0 rgb(0 0 0 / 0.05), 0 1px 2px -1px rgb(0 0 0 / 0.05)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.05), 0 4px 6px -4px rgb(0 0 0 / 0.05)",
    "accentGlow": "0 2px 8px rgba(255, 107, 53, 0.25)"
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "maxContent": "1100px"
  },
  "illustration": {
    "style": "Dynamic Line Art with Strategic Color Infusions",
    "stroke": {
      "primary": { "width": "2px", "color": "#0f0f0f" },
      "secondary": { "width": "1.5px", "color": "#525252" },
      "tertiary": { "width": "1px", "color": "#e5e5e5" },
      "accent": { "width": "2px", "color": "#ff6b35" },
      "dashed": { "width": "1.5px", "color": "#737373", "style": "dashed" }
    },
    "colorBudget": "15-20% of canvas area",
    "negativeSpace": "minimum 35% of canvas",
    "lineCap": "round",
    "lineJoin": "round",
    "bannedKeywords": [
      "cartoon", "cute", "playful", "whimsical", "kawaii", "chibi",
      "retro", "vintage", "grunge", "neon", "cyberpunk", "photorealistic",
      "3D render", "painted", "watercolor", "sketch", "hand-drawn", "doodle",
      "mascot", "emoji", "sticker", "rocket ship", "brain glowing", "lightbulb over head"
    ],
    "approvedKeywords": [
      "minimal", "clean", "precise", "technical", "line art", "outlined",
      "editorial", "sophisticated", "professional", "diagrammatic",
      "focused", "insightful", "efficient", "clear", "warm", "confident"
    ],
    "contentDimensions": {
      "blogHeader": { "width": 1200, "height": 630, "safeZone": "10%" },
      "socialCard": { "width": 1200, "height": 630, "safeZone": "15%" },
      "socialSquare": { "width": 1080, "height": 1080, "safeZone": "10%" },
      "thumbnail": { "width": 400, "height": 300, "safeZone": "5%" },
      "hero": { "width": 1920, "height": 800, "safeZone": "center-weighted" },
      "inArticle": { "width": 800, "height": "variable" },
      "emailHeader": { "width": 600, "height": 200, "safeZone": "10%" }
    }
  }
}